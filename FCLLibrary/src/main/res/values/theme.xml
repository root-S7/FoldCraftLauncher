<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompatDialog默认样式（全屏） -->
    <style name="Dialog.Full.Default" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:textColor">@color/cardview_dark_background</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <!-- AppCompatDialog默认样式（非全屏） -->
    <style name="Dialog.Default" parent="Dialog.Full.Default">
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>